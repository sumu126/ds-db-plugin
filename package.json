{
  "name": "dsh-ds-db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read-only database access for DSH: a connection settings page plus database, table, describe, and query tools, addressed through a pluggable SQL dialect (MySQL bundled).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sumu126/ds-db-plugin.git"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build-host.mjs && node scripts/build-client.mjs && node scripts/build-dialects.mjs",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.types.json && tsc -p dialects/mysql/tsconfig.types.json",
    "test": "node --import tsx/esm --test dialects/mysql/tests/sql-guard.test.ts dialects/mysql/tests/dialect.test.ts dialects/mysql/tests/contract-audit.test.ts",
    "test:dialects": "npm --prefix dialects/mysql test",
    "overlay": "node scripts/dev-overlay.mjs",
    "verify:host": "node --import tsx/esm scripts/verify-host.mjs",
    "verify:settings": "node --import tsx/esm scripts/verify-settings.mts"
  },
  "dependencies": {
    "dsh-dialect-mysql": "file:dialects/mysql"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/schemastery": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-settings": "*",
    "@deepseek-ai/dsh-credentials": "*",
    "@deepseek-ai/dsh-client-store": "*",
    "@deepseek-ai/dsh-client-ui-slots": "*",
    "@deepseek-ai/dsh-client-ui-primitives": "*",
    "@deepseek-ai/dsh-api-remotes": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true },
    "@deepseek-ai/dsh-settings": { "optional": true },
    "@deepseek-ai/dsh-credentials": { "optional": true },
    "@deepseek-ai/dsh-client-store": { "optional": true },
    "@deepseek-ai/dsh-client-ui-slots": { "optional": true },
    "@deepseek-ai/dsh-client-ui-primitives": { "optional": true },
    "@deepseek-ai/dsh-api-remotes": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.31",
    "esbuild": "^0.25.0",
    "lightningcss": "^1.32.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
