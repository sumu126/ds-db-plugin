{
  "name": "dsh-ds-db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read-only database access for DSH: a connection settings page plus database, table, describe, and query tools, addressed through a pluggable SQL dialect (MySQL bundled).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sumu126/ds-db-plugin.git"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build-host.mjs && node scripts/build-client.mjs",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.types.json",
    "test": "node --import tsx/esm --test tests/sql-guard.test.ts tests/dialect-mysql.test.ts",
    "overlay": "node scripts/dev-overlay.mjs",
    "verify:host": "node --import tsx/esm scripts/verify-host.mjs"
  },
  "dependencies": {
    "mysql2": "^3.14.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.31",
    "esbuild": "^0.25.0",
    "lightningcss": "^1.32.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
