{
  "name": "dsh-dialect-postgres",
  "version": "0.1.0",
  "description": "PostgreSQL dialect for dsh-ds-db: an out-of-tree example of adding a database type to DeepSeek Harness without touching the plugin.",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "verify": "node --import tsx/esm scripts/verify.ts"
  },
  "dependencies": {
    "pg": "^8.23.0"
  },
  "peerDependencies": {
    "dsh-ds-db": ">=0.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
